#!/usr/bin/env bash
# ==============================================================================
# agy-hud: Launcher script for Antigravity AGY floating terminal HUD
# Part of agy_niri_noctalia by nicomaure.com.ar
# ==============================================================================

set -e

# Target directory handling with tilde expansion
if [ "$1" = "home" ]; then
    cd "$HOME"
elif [ -n "$1" ]; then
    # Expand leading ~ to $HOME
    TARGET_DIR="${1/#\~/$HOME}"
    if [ -d "$TARGET_DIR" ]; then
        cd "$TARGET_DIR"
    elif [ -d "$HOME/Proyectos/agy" ]; then
        cd "$HOME/Proyectos/agy"
    else
        cd "$HOME"
    fi
elif [ -d "$HOME/Proyectos/agy" ]; then
    cd "$HOME/Proyectos/agy"
else
    cd "$HOME"
fi

# Locate and execute agy
if command -v agy >/dev/null 2>&1; then
    exec agy
elif [ -x "$HOME/.local/bin/agy" ]; then
    exec "$HOME/.local/bin/agy"
else
    echo "=================================================================="
    echo "⚠️  Error: 'agy' CLI not found on PATH nor in ~/.local/bin/agy."
    echo "Please ensure Antigravity CLI is installed and accessible."
    echo "=================================================================="
    echo ""
    read -r -p "Press Enter to exit..."
    exit 1
fi
